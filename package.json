{
  "name": "intentlock-agent-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime verification of cumulative economic intent contracts for multi-tool agent wallets",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "contracts:format:check": "forge fmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "fork:verify": "node scripts/fork-verify.ts",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "viem": "2.55.16",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.10"
  }
}
