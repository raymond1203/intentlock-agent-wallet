{
  "name": "intentlock-agent-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Runtime verification of cumulative economic intent contracts for multi-tool agent wallets",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": ">=11.22.0 <12"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contracts:build": "forge build",
    "contracts:test": "forge test -vvv",
    "contracts:format:check": "forge fmt --check",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "fork:verify": "node scripts/fork-verify.ts",
    "test:integration": "vitest run test/integration",
    "schema:generate": "pnpm run build && node dist/scripts/generate-schemas.js",
    "schema:check": "pnpm run build && node dist/scripts/generate-schemas.js --check",
    "m1:compiler:review": "pnpm run build && node dist/scripts/check-m1-compiler-review.js",
    "m1:golden:run": "pnpm run build && node --env-file-if-exists=.env.local dist/scripts/run-m1-golden-fork.js --require-clean-source",
    "m1:golden:validate": "pnpm run build && node dist/scripts/validate-m1-golden-evidence.js",
    "benchmark:generate": "pnpm run build && node dist/scripts/generate-benchmark.js",
    "benchmark:check": "pnpm run build && node dist/scripts/generate-benchmark.js --check",
    "baseline:llm:run": "pnpm run build && node dist/scripts/run-llm-baseline.js --require-clean-source",
    "m2:validate": "pnpm run build && node dist/scripts/validate-m2.js",
    "m2:execute": "pnpm run contracts:build && pnpm run build && node --env-file-if-exists=.env.local dist/scripts/run-m2-execution.js --require-clean-source --require-all-executed",
    "m2:execute:diagnostic": "pnpm run contracts:build && pnpm run build && node --env-file-if-exists=.env.local dist/scripts/run-m2-execution.js",
    "m2:reviews": "pnpm run build && node dist/scripts/check-m2-reviews.js",
    "m2:evidence": "pnpm run build && node dist/scripts/publish-m2-evidence.js",
    "evaluation:cases": "pnpm run build && node dist/scripts/generate-evaluation-cases.js",
    "evaluation:cases:check": "pnpm run build && node dist/scripts/generate-evaluation-cases.js --check",
    "evaluation:validate-inputs": "pnpm run build && node dist/scripts/run-evaluation.js --validate-inputs",
    "evaluation:freeze:dry-run": "pnpm run build && node dist/scripts/run-freeze-dry-run.js",
    "evaluation:freeze": "pnpm run build && node dist/scripts/freeze-evaluation.js",
    "evaluation:run": "pnpm run build && node --env-file-if-exists=.env.local dist/scripts/run-evaluation.js",
    "evaluation:ablations": "pnpm run build && node dist/scripts/run-ablations.js",
    "evaluation:adaptive": "pnpm run build && node dist/scripts/run-adaptive-evaluation.js",
    "evaluation:analyze": "pnpm run build && node dist/scripts/analyze-results.js",
    "paper:assemble": "pnpm run build && node dist/scripts/assemble-paper.js",
    "submission:audit": "pnpm run build && node dist/scripts/audit-submission.js"
  },
  "dependencies": {
    "viem": "2.55.16",
    "yaml": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.10"
  }
}
