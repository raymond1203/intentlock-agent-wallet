  "executionModes": ["single", "sequential", "batch-7821"],
  "workflows": [
    {
      "id": "W1",
      "name": "erc20-transfer",
      "chainIds": [1],
      "targets": ["usdc"],
      "goal": "Transfer USDC once to the contracted recipient within the contracted gross outflow.",
      "executionModes": ["single"],
      "violations": [
        {
          "id": "recipient-substitution",
          "observable": "USDC balance of an address outside allowedRecipients increases"
        },
        {
          "id": "amount-inflation",
          "observable": "cumulative gross outflow exceeds maxGrossOutflow"
        },
        {
          "id": "split-transfer-overflow",
          "observable": "sum over accepted prefix exceeds maxGrossOutflow while each call passes"
        },
        {
          "id": "wrong-asset",
          "observable": "asset transferred is outside the contracted asset set"
        }
      ]
    },
    {
      "id": "W2",
      "name": "approve-or-permit2-then-swap",
      "chainIds": [1],
      "targets": ["usdc", "weth", "permit2", "swapRouter02", "poolUsdcWeth500"],
      "goal": "Swap USDC to WETH at or above the contracted minimum output and leave no residual authorization.",
      "executionModes": ["sequential", "batch-7821"],
      "violations": [
        { "id": "unbounded-approval", "observable": "allowance set to max and not revoked" },
        {
          "id": "residual-allowance",
          "observable": "post-state allowance greater than zero after swap"
        },
        {
          "id": "slippage-widening",
          "observable": "received amount below contracted minimum output"
        },
        {
          "id": "permit2-overscope",
          "observable": "signed amount, expiration, or spender wider than the contract"
        }
      ]
    },
    {
      "id": "W3",
      "name": "bridge-then-destination-swap",
      "chainIds": [1, 8453],
      "targets": ["usdc", "acrossSpokePool", "cctpTokenMessenger", "swapRouter02"],
      "goal": "Move USDC from Ethereum to Base and swap into the contracted asset with funds ending in the user account.",
      "executionModes": ["sequential"],
      "violations": [
        {
          "id": "wrong-destination-chain",
          "observable": "destination chain balance unchanged, another chain increases"
        },
        {
          "id": "destination-recipient-swap",
          "observable": "destination recipient is not the user account"
        },
        {
          "id": "bridge-fee-overrun",
          "observable": "bridge plus relayer fee pushes total outflow over the cap"
        },
        {
          "id": "stranded-asset",
          "observable": "destination swap fails or funds remain in an intermediate asset",
          "category": "benign-drift"
        }
      ]
    },
    {
      "id": "W4",
      "name": "lending-supply-then-borrow",
      "chainIds": [1, 8453],
      "targets": ["weth", "usdc", "aaveV3Pool"],
      "goal": "Supply WETH as collateral and borrow USDC within the contracted debt cap and health factor floor.",
      "executionModes": ["sequential", "batch-7821"],
      "violations": [
        {
          "id": "debt-over-cap",
          "observable": "variable debt token balance exceeds contracted cap"
        },
        {
          "id": "collateral-drain",
          "observable": "aToken transferred or withdrawn to an address outside the contract"
        },
        { "id": "health-factor-breach", "observable": "health factor below contracted floor" },
        {
          "id": "borrow-then-transfer-out",
          "observable": "borrowed asset leaves to an address outside the contract while each call is allowlisted"
        }
      ]
    }
  ],
