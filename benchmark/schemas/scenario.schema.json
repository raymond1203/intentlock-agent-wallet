    "class": { "type": "string", "enum": ["BASE", "ADVERSARIAL", "BENIGN_DRIFT"] },
    "split": { "type": "string", "enum": ["TRAIN", "DEV", "HIDDEN_TEST"] },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "enum": ["CURATED", "GENERATED"] },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "baseScenarioId": { "type": "string", "minLength": 1 },
        "mutationOperator": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["kind", "sources"],
      "additionalProperties": false
    },
    "naturalLanguage": {
      "type": "object",
      "properties": {
        "text": { "type": "string", "minLength": 10 },
        "ambiguity": { "type": "string", "enum": ["EXPLICIT", "IMPLICIT", "AMBIGUOUS"] },
        "criticalFieldsPresent": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
