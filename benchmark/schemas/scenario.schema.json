    "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,79}$" },
    "version": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "workflow": {
      "type": "string",
      "enum": [
        "TRANSFER",
        "APPROVAL_PERMIT2",
        "SWAP_SINGLE",
        "SWAP_BATCH",
        "BRIDGE_SWAP",
        "LENDING",
        "BATCH_RECOVERY"
      ]
